{
  "name": "the-common-sense",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "check:bundle": "node scripts/check-bundle.mjs",
    "db:migrate:local": "wrangler d1 migrations apply common-sense --local",
    "db:migrate:remote": "wrangler d1 migrations apply common-sense --remote",
    "e2e": "node e2e/run.mjs",
    "icons": "node scripts/make-icons.mjs",
    "deploy": "npm run build && wrangler deploy",
    "worker:dev": "wrangler dev --port 8788"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261107.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
